---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="About | Personal Knowledge Platform" showSidebar={false}>
  <article class="content-body" style="max-width: 720px; margin: 0 auto;">
    <p class="eyebrow">About</p>
    <h1>关于这个平台</h1>
    <p class="lead">
      一个个人知识沉淀与成长记录平台。
    </p>

    <h2>内容领域</h2>
    <ul>
      <li>数字信号处理算法</li>
      <li>卫星通信仿真</li>
      <li>算法可视化</li>
      <li>AI应用技术</li>
    </ul>

    <h2>技术栈</h2>
    <ul>
      <li><strong>框架：</strong> Astro v6</li>
      <li><strong>内容：</strong> Markdown / MDX</li>
      <li><strong>公式：</strong> KaTeX</li>
      <li><strong>代码高亮：</strong> Shiki</li>
    </ul>
  </article>
</BaseLayout>
