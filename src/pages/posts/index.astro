---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublicContent, BASE } from '../../lib/content-utils.mjs';

const PER_PAGE = 4;

const articleModules = import.meta.glob('../../../content/articles/*.md', { eager: true });
const topicModules = import.meta.glob('../../../content/topics/*.md', { eager: true });

function collect(source, type) {
  return Object.entries(source).map(([path, module]) => ({
    ...module.frontmatter,
    type,
    slug: path.split('/').pop().replace(/\.mdx?$/, ''),
  }));
}

const allItems = getPublicContent([
  ...collect(articleModules, 'article'),
  ...collect(topicModules, 'topic'),
]);

const sortedItems = [...allItems].sort((a, b) => {
  const dateA = a.updatedDate || a.date || '0000-00-00';
  const dateB = b.updatedDate || b.date || '0000-00-00';
  if (dateA > dateB) return -1;
  if (dateA < dateB) return 1;
  return a.title.localeCompare(b.title);
});

const totalPages = Math.ceil(sortedItems.length / PER_PAGE) || 1;
const pageItems = sortedItems.slice(0, PER_PAGE);

function hrefFor(item) {
  return `${BASE}/${item.type}s/${item.slug}/`;
}

function formatDate(raw) {
  if (!raw) return '';
  const datePart = typeof raw === 'string' ? raw.split('T')[0] : String(raw).split('T')[0];
  const [y, m, d] = datePart.split('-').map(Number);
  if (!y || !m || !d) return '';
  const months = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun',
                  'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
  return `${d} ${months[m - 1]}, ${y}`;
}

function toIso(raw) {
  if (!raw) return '';
  return typeof raw === 'string' ? raw.split('T')[0] : String(raw).split('T')[0];
}
---

<BaseLayout title="Posts | 王十二的小站" showSidebar={false}>
  <div class="posts-page">
    <!-- ── Page header ── -->
    <header class="posts-header">
      <h1 class="posts-heading">Posts</h1>
      <p class="posts-subtitle">
        All {sortedItems.length} articles I've written.
      </p>
    </header>

    <!-- ── Article list ── -->
    {pageItems.length === 0 ? (
      <p class="posts-empty">No public posts yet — check back soon.</p>
    ) : (
      <ul class="post-list" role="list">
        {pageItems.map((item) => {
          const isUpdated = item.updatedDate && item.updatedDate !== item.date;
          const displayDate = isUpdated ? item.updatedDate : item.date;
          const tags = item.tags ?? [];
          return (
            <li class="post-item">
              <a href={hrefFor(item)} class="post-item-link">
                <h2 class="post-item-title">{item.title}</h2>

                <div class="post-item-meta">
                  <svg class="cal-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                  <time class="post-item-date" datetime={toIso(displayDate)}>
                    {formatDate(displayDate)}
                  </time>
                  {isUpdated && <span class="updated-badge">(Updated)</span>}
                </div>

                {item.summary && (
                  <p class="post-item-summary">{item.summary}</p>
                )}

                {tags.length > 0 && (
                  <div class="post-item-tags">
                    {tags.slice(0, 4).map((tag) => (
                      <span class="post-tag">#{tag}</span>
                    ))}
                  </div>
                )}
              </a>
            </li>
          );
        })}
      </ul>
    )}

    <!-- ── Pagination ── -->
    <nav class="pagination" aria-label="Page navigation">
      <span class="page-btn disabled" aria-disabled="true">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
        Prev
      </span>
      <span class="page-indicator">1 / {totalPages}</span>
      {totalPages > 1 ? (
        <a class="page-btn" href="/posts/2/">
          Next
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
        </a>
      ) : (
        <span class="page-btn disabled" aria-disabled="true">
          Next
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
        </span>
      )}
    </nav>
  </div>
</BaseLayout>

<style>
/* ── Page shell ── */
.posts-page {
  max-width: 720px;
  margin: 0 auto;
  padding: 48px 0 96px;
  font-family: Inter, "Segoe UI", -apple-system, BlinkMacSystemFont, sans-serif;
  color: var(--ap-base);
}

/* ── Header ── */
.posts-header {
  margin-bottom: 32px;
  padding-bottom: 24px;
}

.posts-heading {
  font-family: Inter, "Segoe UI", -apple-system, BlinkMacSystemFont, sans-serif;
  font-size: clamp(1.8rem, 4vw, 2.2rem);
  font-weight: 700;
  letter-spacing: -0.02em;
  margin: 0 0 4px;
  line-height: 1.2;
  color: var(--ap-base);
}

.posts-subtitle {
  font-family: Inter, "Segoe UI", -apple-system, BlinkMacSystemFont, sans-serif;
  font-size: 0.95rem;
  color: var(--ap-muted);
  margin: 0;
  line-height: 1.5;
}

.posts-empty {
  color: var(--ap-muted);
  font-size: 0.95rem;
  text-align: center;
  padding: 60px 0;
}

/* ── Post list ── */
.post-list {
  list-style: none;
  margin: 0;
  padding: 0;
}

.post-item-link {
  display: block;
  padding: 20px 0;
  text-decoration: none;
  color: inherit;
}

.post-item-link:hover {
  text-decoration: none;
}

/* ── Title (AstroPaper: #282728, 700) ── */
.post-item-title {
  font-family: Inter, "Segoe UI", -apple-system, BlinkMacSystemFont, sans-serif;
  font-size: 1.15rem;
  font-weight: 700;
  line-height: 1.5;
  margin: 0 0 2px;
  color: var(--ap-base);
  transition: color 0.12s;
}

.post-item-link:hover .post-item-title {
  color: var(--ap-accent);
}

/* ── Meta row: date + updated ── */
.post-item-meta {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 6px;
}

.cal-icon {
  flex-shrink: 0;
  color: var(--ap-muted-2);
}

.post-item-date {
  font-family: Inter, "Segoe UI", -apple-system, BlinkMacSystemFont, sans-serif;
  font-size: 0.875rem;
  color: var(--ap-muted);
  font-feature-settings: "tnum";
  line-height: 1;
}

.updated-badge {
  font-family: Inter, "Segoe UI", -apple-system, BlinkMacSystemFont, sans-serif;
  font-size: 0.8rem;
  color: var(--ap-muted-2);
  font-style: italic;
}

/* ── Summary ── */
.post-item-summary {
  font-family: Inter, "Segoe UI", -apple-system, BlinkMacSystemFont, sans-serif;
  font-size: 0.875rem;
  color: var(--ap-muted);
  margin: 4px 0 0;
  line-height: 1.65;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* ── Tags ── */
.post-item-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-top: 8px;
}

.post-tag {
  font-family: Inter, "Segoe UI", -apple-system, BlinkMacSystemFont, sans-serif;
  font-size: 0.8rem;
  color: var(--ap-muted);
  transition: color 0.12s;
}

.post-item-link:hover .post-tag {
  color: var(--ap-accent);
}

/* ── Pagination ── */
.pagination {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12px;
  margin-top: 56px;
  padding-top: 28px;
  font-family: Inter, "Segoe UI", -apple-system, BlinkMacSystemFont, sans-serif;
}

.page-btn {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  padding: 7px 16px;
  font-size: 0.875rem;
  font-weight: 600;
  color: var(--ap-muted);
  background: transparent;
  border: 1px solid var(--ap-border);
  border-radius: 8px;
  text-decoration: none;
  transition: border-color 0.12s, color 0.12s;
}

a.page-btn:hover {
  border-color: var(--ap-accent);
  color: var(--ap-accent);
  text-decoration: none;
}

.page-btn.disabled {
  opacity: 0.35;
  cursor: default;
  pointer-events: none;
}

.page-indicator {
  font-size: 0.875rem;
  color: var(--ap-muted);
  font-weight: 500;
  min-width: 56px;
  text-align: center;
  font-feature-settings: "tnum";
}

/* ── Mobile ── */
@media (max-width: 480px) {
  .posts-page {
    padding: 32px 0 64px;
  }

  .post-item-title {
    font-size: 1.05rem;
  }

  .post-item-link {
    padding: 14px 0;
  }
}
</style>
